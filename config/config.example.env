# ─────────────────────────────────────────────
#  LAMP WordPress Pro — Configuration Template
#  Copy this file to config.env and fill in.
#  NEVER commit config.env to Git!
# ─────────────────────────────────────────────

# ── WordPress Database ──────────────────────
DB_NAME="wordpress_db"
DB_USER="wpuser"
DB_PASSWORD="ChangeMe_StrongPassword123!"   # change this!
DB_HOST="localhost"

# ── Your Domain & Email ─────────────────────
DOMAIN="yourdomain.com"                     # e.g. mysite.com (leave blank to use IP)
EMAIL="you@example.com"                     # for SSL cert + email reports

# ── Backup Settings ─────────────────────────
BACKUP_DIR="/backup"
BACKUP_RETENTION_DAYS=28

# ── S3 Backup (optional but recommended) ────
S3_ENABLED=false
S3_BUCKET="your-s3-bucket-name"
AWS_REGION="ap-south-1"

# ── AI Monitoring (optional) ────────────────
AI_MONITORING_ENABLED=false
ANTHROPIC_API_KEY="sk-ant-your-key-here"   # get from console.anthropic.com
AI_REPORT_EMAIL=true

# ── WordPress Site Info ─────────────────────
WP_SITE_TITLE="My WordPress Site"
WP_ADMIN_EMAIL="you@example.com"
